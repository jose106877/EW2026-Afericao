extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h2= title

    .w3-container.w3-padding-16
      if meta
        .w3-panel.w3-pale-blue.w3-leftbar.w3-border-blue
          p
            strong Total de registos:
            |  #{meta.totalRegistos}
          p
            strong Total de marcas:
            |  #{meta.totalMarcas}

      if repairs && repairs.length
        table.w3-table-all.w3-hoverable
          thead
            tr.w3-teal
              th _id
              th Data
              th Nome
              th Matricula
              th Marca
              th Nr Intervencoes
          tbody
            each r in repairs
              tr
                td
                  a(href='/' + r._id)= r._id
                td= r.data
                td= r.nome
                td= r.viatura && r.viatura.matricula ? r.viatura.matricula : ''
                td
                  if r.viatura && r.viatura.marca
                    a(href='/' + encodeURIComponent(r.viatura.marca))= r.viatura.marca
                  else
                    | 
                td= r.nr_intervencoes
      else
        .w3-panel.w3-pale-yellow.w3-leftbar.w3-border-yellow
          p Sem resultados.
